# OutScroll Backend Configuration
# Copy this to .env and fill in your values

# Database (required)
DATABASE_URL=postgresql://outscroll:your_password@localhost:5432/outscroll

# Authentication (required — generate random strings)
JWT_SECRET=your_random_64_char_secret_here
JWT_REFRESH_SECRET=your_random_64_char_refresh_secret_here

# Admin access (required — generate a random string)
ADMIN_KEY=your_random_64_char_admin_key_here

# Server
PORT=3000
NODE_ENV=production

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5175
